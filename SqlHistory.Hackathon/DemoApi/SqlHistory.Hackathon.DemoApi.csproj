<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Shares the SQL Time Machine API's user-secrets, so the demo needs no second copy of the connection string. -->
    <UserSecretsId>7c1f4b52-3d0e-4a8e-9a57-5e2b8d6f1c34</UserSecretsId>
  </PropertyGroup>

</Project>
