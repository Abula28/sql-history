{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Urls": "http://localhost:5190",
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "ConnectionStrings": {
    "SourceDatabase": "Host=localhost;Port=5432;Database=sqlhistory_demo"
  },
  "SqlTimeMachine": {
    "TraceEndpoint": "http://localhost:5180/api/traces"
  },
  "Database": {
    "MaxPoolSize": 40
  },
  "Tracing": {
    "SampleRatio": 1.0
  },
  "Workers": {
    "UserSyncIntervalSeconds": 30,
    "BillingIntervalSeconds": 40
  }
}
