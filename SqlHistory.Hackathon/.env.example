# SQL Time Machine: configuration template. Copy to .env.local (gitignored), fill in,
# then `source SqlHistory.Hackathon/.env.local` before `dotnet run`. Never commit real values.
#
# Environment variables override appsettings.json ("__" stands for ":" in a setting name).
# .NET user-secrets (see README) are the preferred place for the two secrets below.

# PostgreSQL database whose functions and procedures are tracked.
export ConnectionStrings__SourceDatabase="Host=localhost;Port=5432;Database=sqlhistory_demo;Username=YOUR_ROLE;Password=YOUR_PASSWORD"

# Any OpenAI-compatible provider. Ai__ApiKey wins over OPENAI_API_KEY if both are set.
export OPENAI_API_KEY="sk-..."
# export Ai__BaseUrl="https://api.openai.com/v1"
# export Ai__Model="gpt-4.1-mini"
# export Ai__UseJsonSchema="true"     # set false for providers without JSON-schema output

# Optional: poll the database every N seconds (0 = only when "Scan now" is clicked).
# export Scan__AutoScanIntervalSeconds="0"

# Optional: SQLite history file (relative paths are resolved against SqlHistory.Hackathon/Api).
# export ConnectionStrings__SqlHistoryStorage="Data Source=sqlhistory-hackathon.db"

# Only for `dotnet test`: enables the PostgreSQL integration tests. They create and drop
# schemas named sqlhistory_test_* in this database.
# export SQLHISTORY_TEST_POSTGRES="Host=localhost;Database=sqlhistory_demo;Username=YOUR_ROLE;Password=YOUR_PASSWORD"
