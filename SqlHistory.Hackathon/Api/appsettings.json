{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Urls": "http://localhost:5180",
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "ConnectionStrings": {
    "SourceDatabase": "Host=localhost;Port=5432;Database=sqlhistory_demo",
    "SqlHistoryStorage": "Data Source=sqlhistory-hackathon.db",
    "Telemetry": "Data Source=sqlhistory-telemetry.db"
  },
  "Performance": {
    "SampleIntervalSeconds": 30,
    "RetentionHours": 24,
    "MaxSamples": 2000
  },
  "Tracing": {
    "RetentionHours": 24,
    "MaxSpans": 20000
  },
  "Scan": {
    "AutoScanIntervalSeconds": 0
  },
  "Ai": {
    "BaseUrl": "https://api.openai.com/v1",
    "Model": "gpt-4.1-mini",
    "UseJsonSchema": true,
    "TimeoutSeconds": 60
  }
}
